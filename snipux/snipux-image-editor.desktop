[Desktop Entry]
Type=Application
Name=Snipux Image Editor
GenericName=Image Editor
Comment=Mark up, blur or pixelate any screenshot
Exec=__SNIPUX_LAUNCHER__ --image-editor %f
Icon=snipux
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/webp;image/bmp;image/gif;
Terminal=false
