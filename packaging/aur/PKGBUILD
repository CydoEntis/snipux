# Maintainer: CydoEntis
pkgname=snipux-bin
pkgver=1.0.2
pkgrel=1
pkgdesc="Snip, annotate and record your screen"
arch=('x86_64')
url="https://github.com/CydoEntis/snipux"
license=('MIT')
depends=('fuse2')
optdepends=(
    'grim: native Wayland screenshots'
    'slurp: Wayland region selection tools'
    'gpu-screen-recorder: recording on Hyprland and wlroots compositors'
)
provides=('snipux')
conflicts=('snipux')
options=('!strip')
source=(
    "Snipux-${pkgver}-x86_64.AppImage::${url}/releases/download/v${pkgver}/Snipux-${pkgver}-x86_64.AppImage"
    "LICENSE-${pkgver}::${url}/raw/v${pkgver}/LICENSE"
)
sha256sums=(
    '27cd3ae42389a75041b93e72a149ba4abf73b6eed79c83bfd396d69cb325ee99'
    '884c6cad2a7bb78fcfe943452d72f76ec1adb6c9760c9ef7e4e64f6a2fd06895'
)

package() {
    install -Dm755 "${srcdir}/Snipux-${pkgver}-x86_64.AppImage" \
        "${pkgdir}/opt/snipux/Snipux.AppImage"
    install -Dm644 "${srcdir}/LICENSE-${pkgver}" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -d "${pkgdir}/usr/bin"
    ln -s /opt/snipux/Snipux.AppImage "${pkgdir}/usr/bin/snipux"
}
